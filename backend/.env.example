# Copy to .env (never commit .env). Used by docker compose; for mvn/IntelliJ set the same names as environment variables.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@cab.local
ADMIN_PASSWORD=change-me-strong-password
DB_USER=postgres
DB_PASSWORD=postgres

# Neon / Supabase instead of local Postgres (JDBC format!):
# DB_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DB_USER=<neon user>
# DB_PASSWORD=<neon password>

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: real Stripe test mode (leave empty to use the built-in MOCK payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MOCK_ENABLED=true

# Optional: receipt emails
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
